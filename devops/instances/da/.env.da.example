COMPARIA_INSTANCE_NAME=da

COMPARIA_DB_URI="postgres://user:pass@host:5432/comparia_da?sslmode=require"
COMPARIA_REDIS_HOST=localhost
# Same value as the redis.compose.yml REDIS_PASSWORD. The fr and da
# instances share one Redis container, so both need this to match.
COMPARIA_REDIS_PASSWORD=

OPENROUTER_API_KEY=
ORDBOGEN_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
LINKUP_API_KEY=

# Dataset destinations are configured in the admin panel. These two are read
# once, by the migration that creates the destination table, so an instance
# already publishing keeps publishing.
HF_PUSH_DATASET_KEY=
HF_PUSH_DATASET_PATH=

SENTRY_DSN=
SENTRY_ENVIRONMENT=prd
SENTRY_SAMPLE_RATE=1.0

LOG_FORMAT=JSON
# Required outside debug. Generate with: openssl rand -hex 32
# ALTCHA_HMAC_KEY=
# MOCK_RESPONSE=true

# Gates /metrics behind "Authorization: Bearer <token>" when set
# METRICS_TOKEN=
