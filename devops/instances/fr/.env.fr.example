COMPARIA_INSTANCE_NAME=fr

COMPARIA_DB_URI_FR="postgres://user:pass@host:5432/comparia_fr?sslmode=require"
COMPARIA_REDIS_HOST=localhost
# The fr and da instances share one Redis container. Use the same value in
# both deployment environments and for redis.compose.yml.
REDIS_PASSWORD=

OPENROUTER_API_KEY=
ALBERT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
LINKUP_API_KEY=

# Dataset destinations are configured in the admin panel. These two are read
# once, by the migration that creates the destination table, so an instance
# already publishing keeps publishing.
HF_PUSH_DATASET_KEY=
HF_PUSH_DATASET_PATH=

SENTRY_DSN=
SENTRY_ENVIRONMENT=prd
SENTRY_SAMPLE_RATE=1.0

LOG_FORMAT=JSON
# Required outside debug. Generate with: openssl rand -hex 32
ALTCHA_HMAC_KEY=
# Required. Set this to the number of trusted reverse-proxy hops only after
# confirming the production request path (1 when Caddy is the only proxy).
COMPARIA_TRUSTED_PROXY_COUNT=
# MOCK_RESPONSE=true

# Gates /metrics behind "Authorization: Bearer <token>" when set
# METRICS_TOKEN=
