# Public domain (Caddy handles TLS automatically)
PUBLIC_DOMAIN=comparia.example.com

# Public URL of the instance (used by the frontend, no trailing slash)
PUBLIC_URL=https://comparia.example.com

# Database (built-in container)
POSTGRES_USER=comparia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=comparia

# External database (disable the postgres container in docker-compose.yml if used)
# COMPARIA_DB_URI=postgresql://user:password@host:5432/dbname

# LLM API keys
OPENROUTER_API_KEY=
ALBERT_KEY=

# Security
ALTCHA_HMAC_KEY=

# LLM response cache (optional)
CACHE_ENABLED=true
CACHE_PROBABILITY=0.75
CACHE_TTL=172800
CACHE_MAX_RESPONSES=5

# Matomo analytics (optional)
MATOMO_ID=
MATOMO_URL=
