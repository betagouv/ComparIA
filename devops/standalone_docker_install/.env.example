# Domaine public (Caddy gere le TLS automatiquement)
PUBLIC_DOMAIN=comparia.example.com

# URL publique de l'instance (utilisee par le frontend, sans slash final)
PUBLIC_URL=https://comparia.example.com

# Base de donnees
POSTGRES_USER=comparia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=comparia

# LLM API keys
OPENROUTER_API_KEY=
ALBERT_API_KEY=

# Securite
ALTCHA_HMAC_KEY=

# Cache reponses LLM (optionnel)
CACHE_ENABLED=true
CACHE_PROBABILITY=0.75
CACHE_TTL=172800
CACHE_MAX_RESPONSES=5

# Matomo analytics (optionnel)
MATOMO_ID=
MATOMO_URL=
