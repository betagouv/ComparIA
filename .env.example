# Instance configuration
export COMPARIA_INSTANCE_NAME=fr

# Currency used to display model prices and conversation costs (ISO 4217).
# Rates are refreshed daily from the open-source Frankfurter API.
export DISPLAY_CURRENCY=EUR
# Optional manual EUR -> display currency rate. Also enables currencies that are
# unavailable from the API, provides a fully offline mode, and avoids the EUR
# fallback when the rate service is unavailable at startup.
# export DISPLAY_CURRENCY_RATE_FROM_EUR=7.46
# export EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v2
# export EXCHANGE_RATE_CACHE_SECONDS=86400

# Database
export COMPARIA_DB_URI=postgresql://comparia:comparia@localhost:5432/comparia

# Redis (optional - disables rate limiting if unset)
export COMPARIA_REDIS_HOST=localhost

# LLM API key - or use MOCK_RESPONSE=true to skip real API calls
export OPENROUTER_API_KEY=

# Web search API
export LINKUP_API_KEY=

# Prompt checks (content safety and personal data), via the Mistral moderation
# API. Without this key both checks no-op. Everything else about them, including
# whether they log, warn or block, is configured at /admin/prompt-checks.
export MISTRAL_API_KEY=

# Mailing
export SMTP_HOST=smtp-relay.brevo.com
export SMTP_PORT=587
export SMTP_USERNAME="<brevo account email>"
export SMTP_PASSWORD="<SMTP key from Brevo Settings - SMTP & API>"
export EMAIL_FROM=

# Frontend base URL, used to build links in emails (e.g. login code)
# export COMPARIA_APP_URL="http://localhost:5173/"

# Extra CORS origins allowed in production (comma-separated)
# export COMPARIA_CORS_ORIGINS='["https://comparia.beta.gouv.fr"]'

# Auth
# "anonymous_first" (default) or "sign_in_required"
# export AUTH_ACCESS_POLICY=anonymous_first
# export AUTH_DOMAIN_ALLOWLIST='["beta.gouv.fr"]'
# export AUTH_SESSION_LENGTH_DAYS=30

# Admin
# Comma-separated list of emails to promote to admin role on startup (created if absent)
# export ADMIN_EMAILS='["admin@example.com"]'


# Development
# export MOCK_RESPONSE=true
# export LANGUIA_DEBUG=true
# export LOG_FORMAT="RAW"
