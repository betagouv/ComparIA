# Every setting in backend/config.py appears here, commented out if it has a
# sensible default. tests/test_docs.py fails if one goes missing.

# Instance configuration
export COMPARIA_INSTANCE_NAME=fr

# Currency used to display model prices and conversation costs (ISO 4217).
# Rates are refreshed daily from the open-source Frankfurter API.
export DISPLAY_CURRENCY=EUR
# Optional manual EUR -> display currency rate. Also enables currencies that are
# unavailable from the API, provides a fully offline mode, and avoids the EUR
# fallback when the rate service is unavailable at startup.
# export DISPLAY_CURRENCY_RATE_FROM_EUR=7.46
# export EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v2
# export EXCHANGE_RATE_CACHE_SECONDS=86400

# Database
export COMPARIA_DB_URI=postgresql://comparia:comparia@localhost:5432/comparia

# Redis (optional - disables rate limiting if unset)
export COMPARIA_REDIS_HOST=localhost
# export COMPARIA_REDIS_PASSWORD=

# Provider keys, read once: the migration that first creates the OpenRouter,
# Hugging Face and Ordbogen endpoints copies them into the database. After that
# the endpoints own their keys and you edit them at /admin/llms/endpoints, so
# set these before your first `make db-migrate` or not at all.
# MOCK_RESPONSE=true skips real API calls entirely.
export OPENROUTER_API_KEY=
# export HF_INFERENCE_KEY=
# export ORDBOGEN_API_KEY=

# Web search API
export LINKUP_API_KEY=

# Prompt checks (content safety and personal data), via the Mistral moderation
# API. Only a fallback: the key is normally set at /admin/prompt-checks, along
# with everything else about the checks (off, log, warn or block).
export MISTRAL_API_KEY=

# Security
# Spam protection (Altcha). Required unless LANGUIA_DEBUG=true (a dev-only key is
# auto-generated then). A generated key is fine for one dev process but wrong for
# anything with more than one replica or a restart you care about.
# Generate with: openssl rand -hex 32
# export ALTCHA_HMAC_KEY=

# Mailing
export SMTP_HOST=smtp-relay.brevo.com
export SMTP_PORT=587
export SMTP_USERNAME="<brevo account email>"
export SMTP_PASSWORD="<SMTP key from Brevo Settings - SMTP & API>"
export EMAIL_FROM=
# export EMAIL_FROM_NAME=ComparIA
# export SMTP_STARTTLS=true

# Frontend base URL, used to build links in emails (e.g. login code)
# export COMPARIA_APP_URL="http://localhost:5173/"

# Auth
# "anonymous_first" (default) or "sign_in_required"
# export AUTH_ACCESS_POLICY=anonymous_first
# export AUTH_DOMAIN_ALLOWLIST='["beta.gouv.fr"]'
# export AUTH_SESSION_LENGTH_DAYS=30
# export ANONYMOUS_SESSION_LENGTH_DAYS=30

# Login rate limits. The per-IP one is deliberately loose, so a school class
# behind one NAT is never locked out; the per-email one does the real work.
# export AUTH_EMAIL_REQUEST_PER_IP_PER_HOUR=2000
# export AUTH_EMAIL_REQUEST_PER_EMAIL_PER_HOUR=5
# export AUTH_VERIFY_MAX_ATTEMPTS=5
# export AUTH_VERIFY_MAX_ATTEMPTS_PER_EMAIL=10

# Network boundaries. Trust forwarded IPs only when the backend is behind the
# stated number of reverse proxies. Extra CORS origins use a JSON list.
# export COMPARIA_TRUSTED_PROXY_COUNT=0
# export COMPARIA_CORS_ORIGINS='["http://localhost:3000"]'

# Optional bearer token protecting the Prometheus /metrics endpoint.
# export METRICS_TOKEN=

# Admin
# Comma-separated list of emails to promote to admin role on startup (created if absent)
# export ADMIN_EMAILS='["admin@example.com"]'

# Ranking
# How often the leaderboard is recomputed, in seconds.
# export RANKING_INTERVAL_SECONDS=3600
# Vote count the public progress bar counts towards.
# export VOTES_OBJECTIVE=300000

# Dataset publishing. The schedule itself lives at /admin/publication; these are
# the limits the run gets on the machine. Turn the scheduler off here to run it
# as a separate replica instead.
# export DATASET_SCHEDULER_ENABLED=true
# export DATASET_RUN_TIMEOUT=21600
# export DATASET_MEMORY_LIMIT_GB=8
# export DATASET_STATEMENT_TIMEOUT_MS=7200000

# Response cache. Off by default. When on, a share of requests reuse a stored
# answer for the same (model, prompt) instead of calling the provider.
# export CACHE_ENABLED=false
# export CACHE_PROBABILITY=0.5
# export CACHE_TTL=172800
# export CACHE_MAX_RESPONSES=5

# Error reporting
# export SENTRY_DSN=
# export SENTRY_ENVIRONMENT=dev
# export SENTRY_SAMPLE_RATE=0.1

# Development
# export MOCK_RESPONSE=true
# export LANGUIA_DEBUG=true
# Session cookies are Secure by default; turn this off for local http:// dev
# export COMPARIA_COOKIE_SECURE=false
# export LOG_FORMAT="RAW"
