{
  "name": "comparia-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e && npm run test:unit -- --run",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ri": "^1.2.10",
    "@inlang/paraglide-js": "^2.22.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "@types/sanitize-html": "^2.16.0",
    "@unocss/extractor-svelte": "^66.7.5",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-wind4": "^66.7.5",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unocss": "^66.7.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.15.0",
    "amuchina": "^1.0.12",
    "d3": "^7.9.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.16.0",
    "prismjs": "^1.30.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.6",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.5"
  }
}
