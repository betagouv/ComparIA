{
  "name": "comparia-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e && npm run test:unit -- --run",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ri": "^1.2.10",
    "@inlang/paraglide-js": "^2.15.2",
    "@lobehub/icons-static-svg": "^1.85.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/prismjs": "^1.26.6",
    "@types/sanitize-html": "^2.16.0",
    "@unocss/extractor-svelte": "^66.6.0",
    "@unocss/preset-icons": "^66.6.0",
    "@unocss/preset-wind4": "^66.6.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "unocss": "^66.6.8",
    "vite": "^7.3.1",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.14.4",
    "amuchina": "^1.0.12",
    "d3": "^7.9.0",
    "github-slugger": "^2.0.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.14.0",
    "prismjs": "^1.30.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.2",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.2"
  }
}
