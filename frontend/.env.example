# Frontend environment variables example
# Copy this file to .env and update the values as needed

# Public API URL - used by client-side code
PUBLIC_API_URL=http://localhost:8001

# Private API URL - used by server-side code (SSR) in production
# In production Kubernetes: http://languia-default-static:80
# In Docker Compose: http://comparia:80
# In development: http://localhost:8001
PUBLIC_API_LOCAL_URL=http://localhost:8001

# Debug mode for frontend logger (true = debug level, false = info level)
PUBLIC_LANGUIA_DEBUG=false

# Auth wall (must match backend AUTH_ACCESS_POLICY)
# "sign_in_required" triggers server-side redirect to /connexion for unauthenticated users
AUTH_ACCESS_POLICY=anonymous_first

# Login page branding (used when AUTH_ACCESS_POLICY=sign_in_required)
PUBLIC_AUTH_LOGIN_TITLE=Bienvenue sur compar:IA
PUBLIC_AUTH_LOGIN_DESCRIPTION=Comparez les modèles d'IA conversationnelle en aveugle et contribuez à l'évaluation de l'IA en Europe.

# Path prefix the app is mounted under (e.g. "/arena"), for deployments where it
# doesn't own the domain root (see betagouv/ComparIA-landing). Build-time only:
# read by svelte.config.js as kit.paths.base, so one built image can only serve
# one topology (root or a given subpath), not both. Left empty, the app owns the
# domain root, matching current production and the self-hosting Helm chart.
PUBLIC_BASE_PATH=
